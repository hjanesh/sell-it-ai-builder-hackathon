# Copy to .env.local and fill in. Never commit real values.

# Required: Claude (vision, questions, price + web search, copy)
ANTHROPIC_API_KEY=
# Optional override; spec default is Sonnet 5.5
CLAUDE_MODEL=claude-sonnet-5-5

# Optional for local dev (falls back to a local JSON file in .data/), required on Render
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Google sign-in (Supabase Auth). Publishable key, sb_publishable_... (safe in the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL used in share links (e.g. https://sell-it.onrender.com)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Later: Pine Labs (Pro video), ElevenLabs (voice)
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
ELEVENLABS_API_KEY=
# Optional: team UPI ID; makes the Pro video QR a real UPI payment QR
NEXT_PUBLIC_UPI_VPA=
